# Copiar este archivo como ".env" (en esta misma carpeta) y completar.
# El .env real NUNCA se sube al repo (esta en .gitignore).

# --- Twitch (https://dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL=
BOT_REFRESH_TOKEN=
BOT_USER_ID=
ENABLE_TWITCH=1

# --- OBS WebSocket ---
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
ENABLE_OBS=1

# --- Riot (https://developer.riotgames.com) ---
# La key de desarrollo vence cada 24 h: se actualiza solo aca.
RIOT_API_KEY=
RIOT_GAME_NAME=
RIOT_TAG_LINE=
RIOT_REGION_ACCOUNT=americas
RIOT_REGION_LOL=la2

# --- Opcionales ---
# RIOT_REGION_TFT=la2
# TFT_GAME_NAME=
# TFT_TAG_LINE=
# OVERLAY_PATH=
# TRACKER_OVERLAYS_DIR=
DEBUG_ANIMATION=0
